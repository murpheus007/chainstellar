---
interface Props {
	title?: string;
	description?: string;
	ogType?: string;
	ogImage?: string;
	publishedTime?: string;
	twitterSite?: string;
	twitterCreator?: string;
}

const { 
	title = "Damian D. Chidera (Chainstellar) — Creative Writer & Technical Analyst", 
	description = "Damian D. Chidera, known as Chainstellar — Creative Writer & Technical Analyst in the blockchain ecosystem. Solana writer, Web3 content creator, and technical storyteller.",
	ogType = "website",
	ogImage,
	publishedTime,
	twitterSite = "@chainstellar",
	twitterCreator = "@chainstellar"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<meta charset="UTF-8" />
<link
   rel="icon"
   type="image/png"
   href={new URL('/favicon.png?v=1', Astro.site)} />
<link
   rel="shortcut icon"
   type="image/png"
   href={new URL('/favicon.png?v=1', Astro.site)} />
<link
   rel="apple-touch-icon"
   href={new URL('/favicon.png?v=1', Astro.site)} />
<meta
   name="viewport"
   content="width=device-width, initial-scale=1.0" />
<meta name="color-scheme" content="light dark" />

<script is:inline>
   function applyTheme() {
      const theme = (() => {
         if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
            return localStorage.getItem('theme');
         }
         return 'light';
      })();
   
      if (theme === 'dark') {
         document.documentElement.classList.add('dark');
         document.documentElement.setAttribute('data-theme', 'dark');
      } else {
         document.documentElement.classList.remove('dark');
         document.documentElement.setAttribute('data-theme', 'light');
      }
      
      // We don't force save it unless the user toggles it manually in the UI
      // to avoid overwhelming their choice if they change system settings.
   }

   applyTheme();
</script>

<title>{title}</title>
<link rel="canonical" href={canonicalURL} />
<meta
   name="description"
   content={description} />
<meta
   name="keywords"
   content="Damian David Chidera, Damian D. Chidera, Chainstellar, blockchain writer, Solana writer, technical analyst, web3 content creator, crypto writer, content strategist, SuperteamNG, Nigerian blockchain writer, portfolio" />
<meta
   name="author"
   content="Damian D. Chidera" />
<meta name="robots" content="index, follow" />

<meta
   property="og:title"
   content={title} />
<meta
   property="og:description"
   content={description} />
<meta
   property="og:image"
   content={ogImage ? new URL(ogImage, Astro.site) : new URL('/preview.png?v=1', Astro.site)} />
<meta
   property="og:url"
   content={canonicalURL} />
<meta
   property="og:type"
   content={ogType} />
{publishedTime && `${publishedTime}` && (
   <meta property="article:published_time" content={publishedTime} />
)}
<meta property="article:author" content="Damian D. Chidera" />

<meta
   name="twitter:card"
   content="summary_large_image" />
<meta
   name="twitter:title"
   content={title} />
<meta
   name="twitter:description"
   content={description} />
<meta
   name="twitter:image"
   content={ogImage ? new URL(ogImage, Astro.site) : new URL('/preview.png?v=1', Astro.site)} />
<meta name="twitter:site" content={twitterSite} />
<meta name="twitter:creator" content={twitterCreator} />
<meta
   name="google-site-verification"
   content="15te9dAY2cefQGu2AeZ6eastxj0VwMNmGoQop2gIUHI" />
